{
    "Name": "mcserver",
    "Image": "itzg/minecraft-server",
    "PortBindings": {
        "25565": "25565",
        "25575": "25575"
    },
    "NgrokConfig": {
        "name": "mcservertunnel",
        "addr": "25565",
        "proto": "tcp"
    },
    "EnvironmentVariables": {
        "EULA": "TRUE",
        "VERSION": "1.20.4",
        "DIFFICULTY": "normal",
        "SPAWN_PROTECTION": "0",
        "ENABLE_WHITELIST": "TRUE",
        "ENABLE_RCON": "TRUE",
        "RCON_PASSWORD": "RconPassword"
    },
    "MountedVolumes": {
        "F:/private/DockerDiscordBot/Servers/mcserver/Gamesave": "/data"
    }
}